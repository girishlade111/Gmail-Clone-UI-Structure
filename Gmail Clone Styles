/* -------------------- */
/* --- Global Setup --- */
/* -------------------- */
:root {
    --primary-color: #4285F4;
    --primary-color-dark: #3367D6;
    --background-color: #f6f8fc;
    --sidebar-background: #eaf1fb;
    --surface-color: #ffffff;
    --on-surface-color: #202124;
    --on-surface-variant-color: #5f6368;
    --border-color: #dadce0;
    --unread-font-weight: 700;
    --font-family: 'Roboto', 'Helvetica', 'Arial', sans-serif;
    --border-radius: 16px;
    --shadow: 0 1px 2px 0 rgba(60,64,67,0.3), 0 1px 3px 1px rgba(60,64,67,0.15);
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: var(--font-family);
    background-color: var(--background-color);
    color: var(--on-surface-color);
    overflow: hidden; /* Prevent body scroll */
}

ul {
    list-style: none;
}

button, input[type="search"], input[type="email"], input[type="text"] {
    font-family: inherit;
    font-size: 1rem;
    border: none;
    background: none;
    color: inherit;
}

/* -------------------- */
/* --- Layout --------- */
/* -------------------- */
.app-container {
    display: grid;
    height: 100vh;
    grid-template-rows: auto 1fr;
    grid-template-columns: 1fr;
    grid-template-areas:
        "header"
        "main";
}

.app-header {
    grid-area: header;
    display: flex;
    align-items: center;
    padding: 8px 16px;
    background-color: var(--sidebar-background);
    border-bottom: 1px solid var(--border-color);
}

.sidebar {
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    width: 280px;
    background-color: var(--sidebar-background);
    padding: 8px;
    transform: translateX(-100%);
    transition: transform 0.3s ease-in-out;
    z-index: 1000;
}

.sidebar.open {
    transform: translateX(0);
}

.main-content {
    grid-area: main;
    overflow-y: auto;
    display: flex;
}

/* Desktop Layout */
@media (min-width: 768px) {
    .app-container {
        grid-template-columns: 280px 1fr;
        grid-template-areas:
            "header header"
            "sidebar main";
    }

    #menu-toggle {
        display: none;
    }

    .sidebar {
        position: static;
        transform: translateX(0);
        grid-area: sidebar;
        border-right: 1px solid var(--border-color);
    }
}

/* -------------------- */
/* --- Components ----- */
/* -------------------- */

/* Header */
.header-left { display: flex; align-items: center; }
.logo { font-size: 1.4rem; color: var(--on-surface-variant-color); margin-left: 16px; }
.search-container { flex-grow: 1; margin: 0 16px; }
.search-input {
    width: 100%;
    background-color: #e4eaf5;
    padding: 12px 16px;
    border-radius: 24px;
    border: 1px solid transparent;
}
.search-input:focus {
    background-color: var(--surface-color);
    border-color: var(--primary-color);
    outline: none;
    box-shadow: var(--shadow);
}

/* Sidebar */
.sidebar-header { padding: 8px; }
.compose-btn {
    width: auto;
    padding: 12px 24px 12px 16px;
    border-radius: 24px;
    box-shadow: 0 1px 2px 0 rgba(60,64,67,0.3), 0 1px 3px 1px rgba(60,64,67,0.15);
    background-color: #c2e7ff;
    color: #001d35;
    font-weight: 500;
}
.folders-list, .labels-list { margin-top: 16px; }
.folder-item, .label-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 16px;
    border-radius: 0 16px 16px 0;
    cursor: pointer;
    font-weight: 500;
}
.folder-item:hover, .label-item:hover { background-color: rgba(0,0,0,0.05); }
.folder-item.active {
    background-color: var(--primary-color);
    color: white;
    font-weight: var(--unread-font-weight);
}
.labels-section { margin-top: 24px; padding: 0 16px; }
.labels-title { font-size: 0.9rem; color: var(--on-surface-variant-color); }

/* Message List */
.message-list-view, .thread-view { width: 100%; }
.message-list-toolbar {
    display: flex;
    align-items: center;
    padding: 8px 16px;
    border-bottom: 1px solid var(--border-color);
    position: sticky; top: 0; background: var(--background-color);
}
.bulk-actions { display: flex; gap: 8px; margin-left: 16px; }
.message-list-item {
    display: flex;
    align-items: center;
    padding: 12px 16px;
    border-bottom: 1px solid var(--border-color);
    cursor: pointer;
    background-color: var(--surface-color);
    gap: 16px;
}
.message-list-item.unread {
    background-color: var(--sidebar-background);
    font-weight: var(--unread-font-weight);
}
.message-list-item.selected {
    background-color: #e8f0fe;
}
.message-list-item:hover { box-shadow: inset 1px 0 0 #dadce0, inset -1px 0 0 #dadce0, 0 1px 2px 0 rgba(60,64,67,.3), 0 1px 3px 1px rgba(60,64,67,.15); }
.message-sender, .message-subject { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.message-sender { width: 150px; }
.message-subject { flex-grow: 1; }
.message-snippet { color: var(--on-surface-variant-color); margin-left: 8px; font-weight: 400; }
.message-timestamp { margin-left: auto; font-size: 0.85rem; color: var(--on-surface-variant-color); }
.star-icon { color: #ccc; }
.star-icon.starred { color: #fbbc04; }

/* Thread View */
.thread-view { background-color: var(--surface-color); flex-direction: column; }
.thread-view.hidden { display: none; }
.thread-view-toolbar { display: flex; padding: 8px 16px; border-bottom: 1px solid var(--border-color); }
.thread-content { flex-grow: 1; overflow-y: auto; padding: 24px; }
.thread-subject { font-size: 1.5rem; margin-bottom: 24px; }
.thread-message { border: 1px solid var(--border-color); border-radius: 8px; margin-bottom: 16px; }
.thread-message-header { display: flex; justify-content: space-between; padding: 12px 16px; background-color: #f8f9fa; border-bottom: 1px solid var(--border-color); }
.thread-message-body { padding: 16px; line-height: 1.6; }
.thread-reply-container { padding: 16px; border-top: 1px solid var(--border-color); display: flex; gap: 12px; }

@media (min-width: 1024px) {
    .main-content { display: grid; grid-template-columns: 40% 60%; }
    .message-list-view { overflow-y: auto; }
    .thread-view { border-left: 1px solid var(--border-color); display: flex !important; }
    #initial-placeholder { display: none !important; }
    #thread-back-btn { display: none; }
}

/* Modal */
.modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.5);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 2000;
}
.compose-modal {
    background-color: var(--surface-color);
    border-radius: var(--border-radius);
    box-shadow: var(--shadow);
    width: 90%;
    max-width: 680px;
    height: 80vh;
    display: flex;
    flex-direction: column;
}
.modal-header { display: flex; justify-content: space-between; align-items: center; padding: 12px 16px; background: #f2f6fc; border-bottom: 1px solid var(--border-color); }
.compose-form { flex-grow: 1; display: flex; flex-direction: column; padding: 0 16px; }
.form-group { display: flex; align-items: center; border-bottom: 1px solid var(--border-color); position: relative;}
.form-group label { color: var(--on-surface-variant-color); font-size: 0.9rem; padding: 12px 0; margin-right: 8px;}
.form-group input { flex-grow: 1; padding: 12px 0; }
.form-group input:focus { outline: none; }
.cc-bcc-toggles { margin-left: auto; }
.compose-toolbar { padding: 8px 0; border-bottom: 1px solid var(--border-color); }
.compose-body { flex-grow: 1; padding: 12px 0; outline: none; line-height: 1.5; overflow-y: auto; }
.compose-attachments { display: flex; gap: 8px; padding: 8px 0; flex-wrap: wrap; }
.attachment-pill { font-size: 0.8rem; background: #e0e0e0; padding: 4px 8px; border-radius: 12px; }
.modal-footer { padding: 16px; display: flex; justify-content: space-between; align-items: center; }


/* -------------------- */
/* --- Utility -------- */
/* -------------------- */
.hidden { display: none !important; }
.empty-view {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 100%;
    color: var(--on-surface-variant-color);
}
.button-primary {
    background-color: var(--primary-color);
    color: white;
    padding: 10px 24px;
    border-radius: 18px;
    cursor: pointer;
    font-weight: 500;
    transition: background-color 0.2s;
    display: flex;
    align-items: center;
}
.button-primary:hover { background-color: var(--primary-color-dark); }
.button-secondary {
    background-color: transparent;
    border: 1px solid var(--border-color);
    color: var(--on-surface-variant-color);
    padding: 10px 24px;
    border-radius: 18px;
    cursor: pointer;
}
.icon-button {
    background: transparent;
    border: none;
    padding: 8px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px; height: 40px;
}
.icon-button:hover { background-color: rgba(0,0,0,0.08); }
.icon-button svg { width: 24px; height: 24px; color: var(--on-surface-variant-color); }
.link-button {
    color: var(--on-surface-variant-color);
    font-size: 0.9rem;
    cursor: pointer;
    padding: 4px;
}
